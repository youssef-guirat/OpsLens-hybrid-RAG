# The app works in extractive demo mode when this is left empty.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

OPSLENS_SOURCE_DIR=data/documents
OPSLENS_INDEX_PATH=data/index/index.json
OPSLENS_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
OPSLENS_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
OPSLENS_ENABLE_RERANKER=true
OPSLENS_DENSE_TOP_K=12
OPSLENS_SPARSE_TOP_K=12
OPSLENS_FINAL_TOP_K=5
OPSLENS_RRF_K=60
OPSLENS_LOG_LEVEL=INFO

